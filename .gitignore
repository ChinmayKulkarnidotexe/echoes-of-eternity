# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production
dist/
build/

# Python
#
# These are deliberately anchored to the backend. The unanchored versions of
# this list (lib/, build/, var/ ...) match any directory at any depth, which
# silently excluded frontend/src/lib from the repository.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/build/
backend/develop-eggs/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
*.egg-info/
.installed.cfg
*.egg

# Cached Google / Gemini responses. Holds a live Map Tiles session token and is
# rebuilt on demand, so it must never be committed.
backend/.cache/

# Database
*.sqlite
*.sqlite3
*.db

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
