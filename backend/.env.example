# Backend Environment Configuration

# SQLite by default for instant local setup; switch to PostgreSQL when ready:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heritage_db
DATABASE_URL=sqlite:///./heritage.db

# Google Gemini API Key (Required for live Gemini AI responses; precached fallbacks used if empty)
GEMINI_API_KEY=

# Gemini Model Name (e.g. gemini-1.5-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash
