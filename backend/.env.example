# Echoes of Eternity — Backend Environment Configuration

# Database (SQLite by default; switch to PostgreSQL for production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echoes_db
DATABASE_URL=sqlite:///./echoes.db

# Google Gemini API Key (required for live AI narration; fallback mode if empty)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash
